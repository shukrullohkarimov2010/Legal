APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=to_do_list
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PYTHON_API_URL=http://127.0.0.1:5000
OLLAMA_URL=http://localhost:11434/api/generate
LEGAL_MODEL_NAME=legal-strong

# LLM_PROVIDER переключает бэкенд генерации для анализа, чата, генератора и
# конструктора договора, а также квалификации по УК РТ: "ollama" (локальные
# модели, по умолчанию) или "openai". Поиск по кодексам (RAG) провайдера не
# затрагивает — эмбеддинги остаются на Ollama в обоих случаях.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
GPT_MODEL=gpt-6-luna
# Режим «Глубина» в чате и составление документов (договор, иск, заявление)
# идут на более сильной модели и думают дольше. Не задано — используется
# GPT_MODEL. Для документов на gpt-5-nano качество заметно хуже.
GPT_MODEL_DEEP=gpt-6-luna
CHAT_DEEP_REASONING=low
# Анализ договора, генератор договора и квалификация по УК РТ идут на своей
# модели (по умолчанию gpt-6-luna), чат — на GPT_MODEL. Только при LLM_PROVIDER=openai.
ANALYSIS_GPT_MODEL=gpt-6-luna
DRAFT_GPT_MODEL=gpt-6-luna
CRIME_GPT_MODEL=gpt-6-luna
# Действующий «показатель для расчётов» в сомони (значительный/крупный/особо крупный размер в УК РТ
# считаются кратно ему). Меняется законом о бюджете; если пусто, модель честно пишет, с каким порогом сверить сумму.
# На 2026 год — 78 (ст. 24 Закона РТ о госбюджете на 2026 год; https://andoz.tj/docs/zakoni/bujet_davlat_2026_TJ.pdf)
CRIME_CALC_INDICATOR=78
RAG_CODE_NAME="Гражданский кодекс Республики Таджикистан"
# Отдельно от LEGAL_MODEL_NAME: чат должен идти на лёгком профиле (num_ctx
# 8192), а не на legal-strong (16384), который нужен анализу длинных
# договоров. На машине без GPU разные модели в памяти одновременно = своп.
CHAT_MODEL_NAME=legal-fast
CHAT_RAG_TOP_K=8
CHAT_RAG_MAX_CHARS=9000
CHAT_MAX_TOKENS=700
CHAT_KEEP_ALIVE=30m
RAG_SOURCE_PATH=storage/app/rag/codex_tj.docx
RAG_INDEX_FILE=storage/app/rag/codex_tj.index.json
RAG_CHUNK_SIZE=2600
RAG_CHUNK_OVERLAP=350
RAG_TOP_K=5

# Квалификация по УК РТ на /contract/ugalov-kodex: поиск идёт по отдельному
# подындексу Уголовного кодекса, а ответ без опоры в нём не выдаётся.
# CRIME_RAG_MIN_SCORE — порог BM25, ниже которого совпадение считается шумом
# (описание преступления даёт 20-130, посторонний вопрос — 5 и ниже).
CRIME_RAG_TOP_K=8
CRIME_RAG_MIN_SCORE=8.0
# Перед поиском модель переписывает описание события на язык статей УК
# («похитил ноутбук» -> «кража»). 0 — отключить и искать по исходному тексту.
CRIME_QUERY_REWRITE=1
CRIME_QUALIFY_TOP_K=3
CRIME_RAG_MAX_CHARS=2600
# Модель разбора и её бюджет. CRIME_MODEL по умолчанию совпадает с
# LEGAL_MODEL_NAME; меньшая модель отвечает заметно быстрее.
CRIME_MODEL=legal-strong
CRIME_MAX_TOKENS=700
# Краткая квалификация (что делать / что грозит / какие статьи) и полная (то же подробно +
# 6 разделов разбора). Полная в 700 токенов не помещается.
CRIME_MAX_TOKENS_SHORT=650
CRIME_MAX_TOKENS_FULL=1500
# Статьи УПК РТ для совета «что делать»: сколько брать и порог совпадения.
CRIME_PROCEDURE_TOP=3
CRIME_PROCEDURE_MIN_SCORE=12.0
CRIME_NUM_CTX=6144
CRIME_KEEP_ALIVE=30m
# Как часто слать признак жизни, пока модель молчит (секунды).
CRIME_HEARTBEAT_SECONDS=5

# Двуязычный чат: язык ответа определяется по языку вопроса, таджикский
# получается переводом русского ответа моделью NLLB-200 (python/RAG.md).
CHAT_DEFAULT_LANG=ru
TG_TRANSLATE_MODEL_DIR=storage/app/models/nllb-200-distilled-600M-ct2-int8
TG_TRANSLATE_THREADS=4
TG_TRANSLATE_BEAM=2
CHAT_TRANSLATE_FLUSH_CHARS=350

VITE_APP_NAME="${APP_NAME}"
# Поиск по смыслу (векторы OpenAI): построить командой python python/tools/build_embeddings.py
# RAG_EMBED_PROVIDER=auto   # openai | ollama | auto
RAG_VECTOR_WEIGHT=0.6

# Голос персонажей симулятора суда: browser — бесплатный голос браузера (по умолчанию),
# openai — живые голоса OpenAI, около $0,015 за минуту речи (озвучка кешируется).
COURT_TTS=browser
# TTS_MODEL=gpt-4o-mini-tts
RAG_VECTOR_MIN_SCORE=0.42
# CRIME_RAG_USE_VECTORS=0   # страница УК работает на лексическом поиске: с векторами топ-3 смещается
